# Yaoguang Marketing Environment Configuration
# Copy this file to .env and update the values below for your installation
#
# ⚠️  IMPORTANT: Special Characters in Values
# If your values contain the # character, you MUST wrap them in quotes:
#   CORRECT:   DB_PASSWORD="mypass#word123"
#   INCORRECT: DB_PASSWORD=mypass#word123   (will be truncated to "mypass")
#
# This limitation applies only to .env files. Environment variables set directly
# in your shell or container environment do not have this restriction.

# =============================================================================
# REQUIRED VARIABLES - Minimal configuration for first boot
# =============================================================================

# Secret key for encrypting sensitive data in the database (REQUIRED)
# Also used for:
#   - JWT token signing (HS256 symmetric)
#   - Magic code hashing (HMAC-SHA256)
# Generate a secure random string (at least 32 characters)
# Example: openssl rand -base64 32
SECRET_KEY=your-secret-key-here

# Database Configuration (Optional - compose.yaml has working defaults for Docker)
# Uncomment and modify only if using an external database or custom setup
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=notifuse_system

# =============================================================================
# SETUP WIZARD - Configure via Web Interface (Recommended)
# =============================================================================
#
# On first boot, you'll be redirected to the setup wizard at /setup where you can:
# - Configure SMTP settings through a web form
# - Set up the admin account
# - Configure the API endpoint
#
# All settings below can be configured via the setup wizard and are stored
# securely in the database. You only need to set them here if you prefer
# environment-variable-based configuration or want to override database values.
#

# Root administrator email (Optional - can be set via setup wizard)
# ROOT_EMAIL=admin@yourcompany.com

# Public API endpoint URL (Optional - auto-detected via setup wizard)
# API_ENDPOINT=https://emails.yourcompany.com

# PASETO keys - DEPRECATED in v15.0
# For backward compatibility only: If SECRET_KEY is not set, PASETO_PRIVATE_KEY will be used
# PASETO_PRIVATE_KEY=your_base64_encoded_private_key_here

# SMTP Configuration (Optional - can be configured via setup wizard)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@yourcompany.com
# SMTP_FROM_NAME=瑶光营销平台

# SMTP Bridge Server Configuration (Optional - for receiving emails to trigger notifications)
# Legacy: SMTP_RELAY_* environment variables are still accepted for backward compatibility
# Enable this to receive emails that trigger transactional notifications via API
# Authentication uses SMTP AUTH with workspace_id as username and api_key as password
# 
# IMPORTANT: If SMTP_BRIDGE_ENABLED is explicitly set (even to "false"), the setup wizard
# will NOT be able to configure SMTP bridge - it will be locked to the env var value.
# Only leave this unset (commented out) if you want the setup wizard to configure it.
# SMTP_BRIDGE_ENABLED=false
# SMTP_BRIDGE_PORT=587
# SMTP_BRIDGE_DOMAIN=smtp.yourdomain.com

# TLS posture — one of: off | starttls | implicit
#   starttls  Default when certs are provided. Listens plaintext on port 587 and
#             requires clients to upgrade via STARTTLS before AUTH.
#   implicit  TLS-from-byte-1 (SMTPS). Set SMTP_BRIDGE_PORT=465. Works with
#             any dumb L4 TLS terminator if you want to front with a proxy.
#   off       No TLS at all. Only safe when fronted by a TLS-terminating
#             reverse proxy (Caddy layer4, HAProxy, nginx Mail, Postfix,
#             stunnel) on a trusted network. Required in production if you
#             don't want to manage certs inside Yaoguang Marketing.
# SMTP_BRIDGE_TLS=starttls

# TLS Configuration (Base64 Encoded Certificates) — required for starttls and implicit modes
# Perfect for containers and secret managers - no file mounting needed
# To encode your certificates:
#   CERT_BASE64=$(cat /etc/letsencrypt/live/smtp.example.com/fullchain.pem | base64 -w 0)
#   KEY_BASE64=$(cat /etc/letsencrypt/live/smtp.example.com/privkey.pem | base64 -w 0)
# SMTP_BRIDGE_TLS_CERT_BASE64=LS0tLS1CRUdJTi...
# SMTP_BRIDGE_TLS_KEY_BASE64=LS0tLS1CRUdJTi...

# Getting Let's Encrypt Certificates:
# 1. Install certbot: apt-get install certbot (or brew install certbot)
# 2. Get certificate:
#    certbot certonly --standalone -d smtp.yourcompany.com
#    OR for DNS validation (no port 80 needed):
#    certbot certonly --manual --preferred-challenges dns -d smtp.yourcompany.com
# 3. Set auto-renewal:
#    certbot renew --deploy-hook "docker compose restart backend"

# =============================================================================
# OPTIONAL VARIABLES - Uncomment and modify if needed
# =============================================================================

# Privacy and Update Settings (Optional - can be configured via setup wizard)
# TELEMETRY=true                                # Send anonymous usage statistics (default: configured in setup wizard)
# CHECK_FOR_UPDATES=true                        # Check for new versions and security updates (default: configured in setup wizard)
# Note: If not set via environment variables, these will be configured via the setup wizard.
# Environment variables always take precedence over database settings.

# Server Configuration
# SERVER_PORT=8080
# SERVER_HOST=0.0.0.0
# CORS_ALLOW_ORIGIN=*
# ENVIRONMENT=production
# LOG_LEVEL=info

# Web Analytics: optional MaxMind GeoLite2/GeoIP2 City database for geo
# dimensions (country/region/city). Without a database, geo stays empty.
# A GeoLite2 City database ships with Yaoguang Marketing at /app/geoip/GeoLite2-City.mmdb
# and is used automatically. To use a fresher or commercial copy, drop it in the
# mounted data directory as GeoLite2-City.mmdb (it takes precedence) or set this
# variable (see https://github.com/maxmind/geoipupdate).
# GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# Database Configuration (for custom setups)
# DB_PREFIX=notifuse
# DB_NAME=notifuse_system
# DB_SSLMODE=require

# Database Connection Pool Settings
# DB_MAX_CONNECTIONS=100                    # Total max connections across all databases (default: 100)
# DB_MAX_CONNECTIONS_PER_DB=3               # Max connections per workspace database (default: 3)
# DB_CONNECTION_MAX_LIFETIME=10m            # Maximum lifetime of a connection (default: 10m)
# DB_CONNECTION_MAX_IDLE_TIME=5m            # Maximum idle time before closing (default: 5m)

# Development Compose runtime
# DEV_HOT_RELOAD=true                       # true: Air/Vite reload; false: source applies on container restart
# VITE_USE_POLLING=true                     # Recommended for Docker Desktop bind mounts
# VITE_POLLING_INTERVAL=500                 # File polling interval in milliseconds
# FRONTEND_HOST_PORT=8081                   # Nginx gateway, Console, Notification Center and API
# CONTAINER_HTTP_PROXY=http://host.docker.internal:7897
# CONTAINER_HTTPS_PROXY=http://host.docker.internal:7897
# DOCKER_BUILD_HTTP_PROXY=http://host.docker.internal:7897
# DOCKER_BUILD_HTTPS_PROXY=http://host.docker.internal:7897
# FRONTEND_BASE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine

# Realtime runtime and scalable infrastructure
# `all` is used by the compact default Compose backend. compose.ha.yaml assigns
# a dedicated role to each service, so normally only REALTIME_MODE is overridden.
# YAOGUANG_ROLE=all                         # all | api | outbox-relay | rule-worker | journey-worker | delivery-worker | analytics-worker | scheduler
# NOTIFUSE_ROLE=all                         # Legacy fallback for one compatibility cycle; YAOGUANG_ROLE wins when both are set
# REALTIME_MODE=legacy                       # legacy | shadow | primary

# RabbitMQ (required for shadow/primary; replace every example credential in production)
# RABBITMQ_USER=notifuse
# RABBITMQ_PASSWORD=replace-with-a-url-safe-password
# RABBITMQ_URL=amqp://notifuse:replace-with-a-url-safe-password@rabbitmq:5672/
# RABBITMQ_PREFETCH=100
# RABBITMQ_PUBLISH_CONFIRM_TIMEOUT=5s

# Redis is a cache and frequency-cap dependency, never the source of truth
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=replace-with-a-strong-password
# REDIS_DB=0

# ClickHouse is a rebuildable analytics projection
# CLICKHOUSE_ADDR=clickhouse:9000
# CLICKHOUSE_DATABASE=notifuse
# CLICKHOUSE_USER=notifuse
# CLICKHOUSE_PASSWORD=replace-with-a-strong-password
# CLICKHOUSE_BATCH_SIZE=1000
# CLICKHOUSE_FLUSH_INTERVAL=1s

# S3-compatible asset storage (Compose uses MinIO)
# MINIO_ROOT_USER=notifuse
# MINIO_ROOT_PASSWORD=replace-with-a-strong-password
# S3_PROVIDER=minio
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9002
# S3_BUCKET=notifuse-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY=notifuse
# S3_SECRET_KEY=replace-with-a-strong-password
# S3_FORCE_PATH_STYLE=true

# Durable work claiming
# JOURNEY_LEASE=60s
# JOURNEY_HEARTBEAT=20s                     # Must be shorter than JOURNEY_LEASE
# OUTBOX_BATCH_SIZE=200
# OUTBOX_LEASE=30s

# External audience and event ingest backpressure (per API replica)
# INGEST_MAX_BATCH_SIZE=500
# INGEST_MAX_INFLIGHT=32

# PgBouncer transaction-pool tuning
# PGBOUNCER_MAX_CLIENT_CONN=5000
# PGBOUNCER_DEFAULT_POOL_SIZE=50
# PGBOUNCER_RESERVE_POOL_SIZE=10
# PGBOUNCER_MAX_DB_CONNECTIONS=100
# POSTGRES_MAX_CONNECTIONS=300

# Task Scheduler Configuration
# The internal scheduler handles task execution automatically
# TASK_SCHEDULER_ENABLED=true               # Enable/disable internal scheduler (default: true)
# TASK_SCHEDULER_INTERVAL=30s               # How often to check for pending tasks (default: 30s)
# TASK_SCHEDULER_MAX_TASKS=100              # Max tasks to process per execution (default: 100)

# Broadcast Data Feeds
# Broadcasts can fetch external JSON data feeds (global and per-recipient) to
# personalize content. By default these outbound requests are SSRF-protected:
# the server refuses to connect to private, loopback, link-local, and reserved
# IP ranges (including the cloud instance metadata endpoint).
# Enable the option below ONLY in trusted, self-hosted deployments that
# intentionally point data feeds at services on their internal/private network.
# Turning it on disables SSRF protection for data-feed requests.
# BROADCAST_DATA_FEED_ALLOW_PRIVATE_HOSTS=false

# Legacy upstream plan limits (leave unset when self-hosting)
# Every limit below is 0 = unlimited, which is what an unset variable resolves
# to - a self-hosted installation is never limited by these. A negative value is
# rejected at startup.
# PLAN_MAX_ACTIVE_CONTACTS=0                # Max contacts active in the billing period
# PLAN_MAX_STORED_CONTACTS=0                # Max contacts stored in total
# PLAN_MAX_MONTHLY_EVENTS=0                 # Max events recorded per month
# PLAN_MAX_MONTHLY_PAGEVIEWS=0              # Max web analytics pageviews per month
# PLAN_DATA_RETENTION_MONTHS=0              # Months of history kept
# MAX_USERS=0                               # Max team members across the installation
# MAX_WORKSPACES=0                          # Max workspaces that can be created

# Tracing Configuration
# TRACING_ENABLED=false
# TRACING_SERVICE_NAME=yaoguang-marketing-api
# TRACING_SAMPLING_PROBABILITY=0.1
# TRACING_TRACE_EXPORTER=none
# TRACING_JAEGER_ENDPOINT=http://localhost:14268/api/traces
# TRACING_ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
# TRACING_STACKDRIVER_PROJECT_ID=
# TRACING_AZURE_INSTRUMENTATION_KEY=
# TRACING_DATADOG_AGENT_ADDRESS=localhost:8126
# TRACING_DATADOG_API_KEY=
# TRACING_XRAY_REGION=us-west-2
# TRACING_AGENT_ENDPOINT=localhost:8126
# TRACING_METRICS_EXPORTER=none
# TRACING_PROMETHEUS_PORT=9464
